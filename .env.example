# WARISAN SUARA - Environment Variables Template
# Copy to .env and fill with your Cloudflare credentials
# NEVER commit .env (it's gitignored)

# Database (local dev)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Cloudflare Integration
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# Cloudflare D1
CF_D1_DATABASE_NAME=warisan-suara-db
CF_D1_DATABASE_UUID=your_d1_database_uuid

# Cloudflare KV
CF_KV_NAMESPACE_ID=your_kv_namespace_id

# Cloudflare R2 (S3-compatible, optional)
CF_R2_ACCESS_KEY_ID=your_r2_access_key
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CF_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CF_R2_BUCKET=warisan-suara-audio

# Cloudflare Workers AI models
CF_AI_LLM=@cf/meta/llama-3.1-8b-instruct
CF_AI_ASR=@cf/openai/whisper
CF_AI_TTS=@cf/myshell-ai/melotts

# Feature flag
USE_CLOUDFLARE_AI=1

# Cloudflare Turnstile (optional, for production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
